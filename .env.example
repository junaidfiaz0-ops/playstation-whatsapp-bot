# ==============================================================
# PLAYSTATION WORLD MULTAN - WHATSAPP AI AGENT CONFIGURATION
# ==============================================================

# Google Gemini API Key (Get free key from: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API Settings (Get from: https://developers.facebook.com)
# 1. Your permanent or temporary system user access token
WHATSAPP_TOKEN=
# 2. Your Phone Number ID from WhatsApp App Dashboard
WHATSAPP_PHONE_NUMBER_ID=
# 3. Custom verification token you choose for Meta Webhook setup
WHATSAPP_VERIFY_TOKEN=playstation_world_multan_secret_token_2025
WHATSAPP_API_VERSION=v21.0

# Server Settings
HOST=0.0.0.0
PORT=8000
SHOP_NAME=PlayStation World Multan
